{
  "name": "console-typer-for-proxmox",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome extension that types saved text and IP settings into the Proxmox VE noVNC console as keystrokes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "build": "node scripts/build.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "assets": "node scripts/icons.mjs && node scripts/screenshots.mjs",
    "assets:icons": "node scripts/icons.mjs",
    "assets:screenshots": "node scripts/screenshots.mjs",
    "version": "node scripts/sync-version.mjs && git add src/manifest.json"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
